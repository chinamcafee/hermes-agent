{
  "schema_version": 1,
  "name": "team-cloud-bug-triage-v0",
  "severity_levels": [
    {
      "severity": "P0",
      "definition": "Data leak, cross-org access, unrecoverable outage.",
      "first_response_minutes": 30,
      "target_resolution_hours": 24
    },
    {
      "severity": "P1",
      "definition": "Pilot blocker, auth failure, backup/restore failure.",
      "first_response_minutes": 120,
      "target_resolution_hours": 48
    },
    {
      "severity": "P2",
      "definition": "Degraded workflow with workaround.",
      "first_response_minutes": 480,
      "target_resolution_hours": 120
    },
    {
      "severity": "P3",
      "definition": "Cosmetic issue, docs gap, minor usability problem.",
      "first_response_minutes": 1440,
      "target_resolution_hours": 240
    }
  ],
  "release_blocker_rules": [
    "security_data_leak",
    "cross_org_access",
    "backup_restore_failure",
    "authz_fail_open",
    "pilot_team_blocked"
  ],
  "escalation": {
    "owner": "team-cloud-beta-coordinator",
    "channels": [
      "pilot-war-room",
      "security-oncall",
      "release-manager"
    ],
    "daily_cutoff": "17:00"
  }
}
