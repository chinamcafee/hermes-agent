{
  "schema_version": 1,
  "name": "team-cloud-pilot-telemetry-review-v0",
  "pilot_source": "teamDoc/GADoc/artifacts/pilot/team-cloud-pilot-onboarding-v0.json",
  "period": {
    "duration_days": 14,
    "cadence": "weekly",
    "checkpoints": [
      "day-7",
      "day-14"
    ]
  },
  "signals": [
    "usage",
    "latency",
    "errors",
    "security_events",
    "backup_jobs",
    "cost_quotas"
  ],
  "release_gates": {
    "open_p0_p1": 0,
    "cross_org_access": 0,
    "personal_memory_leakage": 0,
    "authz_fail_open": 0,
    "backup_restore_failures": 0
  },
  "outputs": [
    "weekly_report",
    "security_exception_log",
    "performance_delta",
    "beta_exit_inputs"
  ],
  "owners": {
    "coordinator": "team-cloud-beta-coordinator",
    "security": "security-oncall",
    "sre": "team-cloud-sre"
  }
}
