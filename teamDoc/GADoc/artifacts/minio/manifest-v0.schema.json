{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/minio/manifest-v0.schema.json",
  "title": "Hermes Team Cloud Object Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "object_id",
    "org_id",
    "bucket",
    "object_key",
    "content_type",
    "size_bytes",
    "checksum_sha256",
    "encryption",
    "retention",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "object_type": {
      "type": "string",
      "enum": [
        "personal_backup",
        "org_export",
        "attachment",
        "document_source",
        "restore_staging"
      ]
    },
    "object_id": {"type": "string", "format": "uuid"},
    "org_id": {"type": "string", "format": "uuid"},
    "owner_member_id": {"type": ["string", "null"], "format": "uuid"},
    "team_id": {"type": ["string", "null"], "format": "uuid"},
    "project_id": {"type": ["string", "null"], "format": "uuid"},
    "session_id": {"type": ["string", "null"], "format": "uuid"},
    "document_id": {"type": ["string", "null"], "format": "uuid"},
    "bucket": {"type": "string", "minLength": 3},
    "object_key": {"type": "string", "minLength": 1},
    "content_type": {"type": "string", "minLength": 1},
    "size_bytes": {"type": "integer", "minimum": 0},
    "checksum_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "algorithm", "key_id"],
      "properties": {
        "mode": {"type": "string", "enum": ["org_managed", "user_passphrase", "none"]},
        "algorithm": {"type": "string", "enum": ["AES-256-GCM", "none"]},
        "key_id": {"type": ["string", "null"]},
        "wrapped_data_key_ref": {"type": ["string", "null"]}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "delete_after", "legal_hold"],
      "properties": {
        "policy": {"type": "string", "enum": ["member_controlled", "org_policy", "temporary", "none"]},
        "delete_after": {"type": ["string", "null"], "format": "date-time"},
        "legal_hold": {"type": "boolean"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
