# Hermes Team Cloud local compose defaults.
# Secret values live in ./secrets/*.txt and are generated by scripts/team-cloud-secrets.sh.

COMPOSE_PROJECT_NAME=hermes-team-cloud
HERMES_TEAM_PLATFORM=linux/amd64

TEAM_CLOUD_ENVIRONMENT=local
TEAM_CLOUD_BIND_HOST=0.0.0.0
TEAM_CLOUD_API_PORT=8780
TEAM_CLOUD_LOG_LEVEL=INFO
TEAM_CLOUD_JWT_ISSUER=http://localhost:18000
TEAM_CLOUD_CASDOOR_BASE_URL=http://casdoor:8000
TEAM_CLOUD_CASDOOR_CLIENT_ID=hermes-team-api
TEAM_CLOUD_SPICEDB_ENDPOINT=spicedb:50051
TEAM_CLOUD_MINIO_ENDPOINT=http://minio:9000
TEAM_CLOUD_MINIO_ACCESS_KEY=hermes_team

TEAM_CLOUD_DATABASE_URL_FILE=./secrets/team_cloud_database_url.txt
TEAM_CLOUD_CASDOOR_CLIENT_SECRET_FILE=./secrets/team_cloud_casdoor_client_secret.txt
TEAM_CLOUD_SPICEDB_PRESHARED_KEY_FILE=./secrets/team_cloud_spicedb_preshared_key.txt
TEAM_CLOUD_MINIO_SECRET_KEY_FILE=./secrets/team_cloud_minio_secret_key.txt
TEAM_CLOUD_ENCRYPTION_KEY_FILE=./secrets/team_cloud_encryption_key.txt
TEAM_CLOUD_BACKUP_MOUNT_PATH=./backups
TEAM_CLOUD_TLS_CERT_FILE=./certs/dev/dev-cert.pem
TEAM_CLOUD_TLS_KEY_FILE=./certs/dev/dev-key.pem

ALPINE_IMAGE=alpine:3.22.2
CASDOOR_IMAGE=casbin/casdoor:3.60.1
SPICEDB_IMAGE=ghcr.io/authzed/spicedb:v1.53.0-debug
ZED_IMAGE=ghcr.io/authzed/zed:v1.1.1-debug
POSTGRES_IMAGE=pgvector/pgvector:0.8.2-pg18-trixie
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MAILPIT_IMAGE=axllent/mailpit:v1.29.5
TEAM_WEB_IMAGE=nginx:1.29.3-alpine
TEAM_CLOUD_PYTHON_BASE_IMAGE=python:3.13-slim-bookworm
TEAM_API_IMAGE=hermes-team-api:dev
TEAM_WORKER_IMAGE=hermes-team-worker:dev
HERMES_RUNTIME_IMAGE=hermes-team-runtime:dev
